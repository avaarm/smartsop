# ── SmartSOP environment ──
# Copy to .env and fill in. Values marked REQUIRED (prod) must be set before
# deploying — the backend refuses to start in production without a real secret.

# Deployment mode: development | production. In production, debug is off and a
# real signing secret is required. (FLASK_ENV=production is honored too.)
APP_ENV=development

# REQUIRED (prod). Signs JWTs and the session cookie. Use a long random string,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=
# Optional: separate secret for the Flask session cookie (falls back to JWT_SECRET).
SECRET_KEY=
JWT_TTL_HOURS=168

# Database. Postgres in production; omit for the local SQLite default.
DATABASE_URL=postgresql://smartsop:smartsop@localhost:5432/smartsop
# Let the app create tables directly (dev only). Keep false in production and
# apply schema with `flask --app gmp_server db upgrade`.
AUTO_CREATE_TABLES=true
# Connection pool tuning (optional).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# CORS: comma-separated origins allowed to call the API (your frontend URL).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# LLM (Ollama) host.
OLLAMA_HOST=http://localhost:11434

# Background tasks (Celery + Redis). Set ASYNC_TASKS_ENABLED=true to offload
# long LLM calls to the worker.
ASYNC_TASKS_ENABLED=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Rate limiting. Use a shared Redis URI in production so limits hold across
# workers (in-memory otherwise).
RATELIMIT_STORAGE_URI=
AUTH_RATELIMIT=10 per minute
LLM_RATELIMIT=30 per hour

# Request body cap in bytes (default 16 MB).
MAX_CONTENT_LENGTH=16777216

# Document storage: local (default) or s3. For s3, also set the bucket/region.
DOCUMENT_STORAGE=local
GENERATED_DOCS_DIR=./generated_docs
AWS_REGION=

# ── SSO / OIDC (optional) ──
# Set all five to enable the "Sign in with <provider>" button.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_PROVIDER_NAME=SSO
SSO_SCOPE=openid email profile
SSO_REDIRECT_URI=http://localhost:5001/api/auth/sso/callback
SSO_FRONTEND_REDIRECT=http://localhost:4200/login
