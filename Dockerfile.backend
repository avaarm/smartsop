FROM python:3.11-slim

WORKDIR /app

# Install system deps for lxml, reportlab
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libxml2-dev libxslt1-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-gmp.txt .
RUN pip install --no-cache-dir -r requirements-gmp.txt

COPY ml_model/ ml_model/
COPY gmp_server.py gunicorn.conf.py ./

# Generated documents are written here at runtime (local storage backend).
# Set DOCUMENT_STORAGE=s3 to keep them off the instance for horizontal scaling.
RUN mkdir -p generated_docs

EXPOSE 5001

# Threaded gunicorn workers so slow LLM calls don't block other requests.
# Tune via GUNICORN_WORKERS / GUNICORN_THREADS (see gunicorn.conf.py).
CMD ["gunicorn", "--config", "gunicorn.conf.py", "gmp_server:app"]
